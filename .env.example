# Brasil SaaS ERP Environment Variables
# Copy this file to .env and configure your environment

# ============================================
# Database Configuration
# ============================================
# O ERP le MONGODB_PASSWORD (com o DB no meio). O MONGO_PASSWORD sem o
# DB e' o apelido do docker-compose, que usa esse nome na variavel de
# ambiente do container. Os dois precisam ter o mesmo valor.
DB_USER=sa
DB_PASSWORD=ALTERE_ME
MONGODB_USERNAME=admin
MONGODB_PASSWORD=ALTERE_ME
MONGO_PASSWORD=ALTERE_ME
MONGODB_URI=mongodb://admin:ALTERE_ME@localhost:27017/brasil-saas?authSource=admin
RABBITMQ_PASSWORD=ALTERE_ME

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=brasil-saas-erp-secret-key-minimo-32-bytes-2026
JWT_EXPIRATION=86400000  # 24 hours in milliseconds
JWT_REFRESH_EXPIRATION=604800000  # 7 days in milliseconds

# ============================================
# MinIO Storage Configuration
# ============================================
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin123
MINIO_BUCKET=brasil-saas

# ============================================
# Application Configuration
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Fiscal Configuration (for production)
# ============================================
# Path to digital certificate for NF-e
CERTIFICATE_PATH=/path/to/certificate.pfx
CERTIFICATE_PASSWORD=your-certificate-password

# ============================================
# AI Configuration
# ============================================
OPENAI_API_KEY=your-openai-api-key
SPRING_AI_OPENAI_API_KEY=$OPENAI_API_KEY

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_PROTOCOL=smtp

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/brasil-saas/application.log

# ============================================
# Performance Configuration
# ============================================
JAVA_OPTS=-Xmx4g -Xms1g -XX:MaxMetaspaceSize=256m
