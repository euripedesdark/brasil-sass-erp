[Unit]
Description=Brasil SaaS ERP - Serviço de Relatórios e BI
Documentation=https://github.com/euripedesdark/BRASIL-SAAS-ERP
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=brasil-saas
Group=brasil-saas
WorkingDirectory=/opt/brasil-saas
ExecStart=/usr/bin/java -jar /opt/brasil-saas/brasil-saas-erp.jar --spring.profiles.active=servico-relatorios
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brasil-saas-relatorios

MemoryLimit=3G
CPUQuota=150%

Environment="JAVA_OPTS=-Xmx2560m -Xms768m -XX:+UseG1GC"
Environment="TZ=America/Sao_Paulo"

[Install]
WantedBy=multi-user.target
