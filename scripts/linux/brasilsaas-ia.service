[Unit]
Description=Brasil SaaS ERP - Serviço de IA Corporativa
Documentation=https://github.com/euripedesdark/BRASIL-SAAS-ERP
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=brasil-saas
Group=brasil-saas
WorkingDirectory=/opt/brasil-saas
ExecStart=/usr/bin/java -jar /opt/brasil-saas/brasil-saas-erp.jar --spring.profiles.active=servico-ia
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brasil-saas-ia

MemoryLimit=4G
CPUQuota=200%

Environment="JAVA_OPTS=-Xmx3584m -Xms1024m -XX:+UseG1GC"
Environment="OPENAI_API_KEY=${OPENAI_API_KEY}"
Environment="TZ=America/Sao_Paulo"

[Install]
WantedBy=multi-user.target
