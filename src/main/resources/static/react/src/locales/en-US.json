  "donate": {
    "button": "Support the Project",
    "title": "Support Development",
    "body": "Brasil SaaS ERP is an open source ERP maintained by a single developer. If this project helped you, your company or your team, please consider supporting its development with a PIX donation."
  },
  "about": {
    "subtitle": "Brasil SaaS ERP — open source business management system",
    "license": "License",
    "licenseBody": "This project is under the GNU Affero General Public License v3.0. The clause that matters for an ERP reached over a browser is section 13: whoever points a browser at this system is entitled to the source code. The full text is in LICENSE.md, and the third-party credits are in NOTICE.md.",
    "history": "History",
    "historyP1": "Brasil SaaS ERP started as a management system written in Delphi and was migrated to Java Spring Boot on Oracle JDK 21. The migration moved the core to Spring Boot 3.3.5 while keeping the modules separate, and the frontend was rewritten in React.",
    "historyP2": "The system is multi-company by construction: every record carries its owning company, and a tenant filter stops one company from seeing another's data. Authentication comes from Active Directory through the Auth Service, and authorization comes from directory groups.",
    "historyP3": "It is maintained by one person, in the time left over from work.",
    "roadmap": "Roadmap",
    "roadmapNow": "In production",
    "roadmapWip": "In progress",
    "roadmapTodo": "Not implemented",
    "tech": "Technologies",
    "credits": "Credits",
    "creditsBody": "This project is built on other people's work, and the full list is in NOTICE.md. The fiscal emission libraries are by Samuel Oliveira (Java NFe, Java MDFe, Java CTe, Java Certificate, PDF Signature and the EFD ones), by Eduardo Kuhn (nfse) and by Infosimples (city hall integration). eSocial is from TST, and Akretion's CNAB manager is by Raphael Valyi. The whole Spring ecosystem is from VMware.",
    "support": "Support the Project",
    "supportP1": "Brasil SaaS ERP is an open source ERP maintained by a single developer. If this project helped you, your company or your team, please consider supporting its development.",
    "supportP2": "A donation of any amount pays for the server, the digital certificate and the city hall issuance fees. It does not buy a delivery date on any issue.",
    "roadmapNowItems": [
      "Authentication against Active Directory through the Auth Service",
      "Registrations with multiple companies and tenant filtering",
      "Finance, inventory, sales and services",
      "NF-e and NFC-e",
      "São Paulo NFS-e proxy with failover"
    ],
    "roadmapWipItems": [
      "CT-e and MDF-e",
      "HR management",
      "Production",
      "AI assistant in the tax module"
    ],
    "roadmapTodoItems": [
      "eSocial bookkeeping",
      "Contributions and tax assessment",
      "Full CIBS and IBS/CBS regime"
    ],
    "title": "About the Project"
  },
