[Unit]
Description=Backup do banco PostgreSQL do Brasil SaaS ERP
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/brasil-saas/erp.env
Environment=BACKUP_DIR=/var/backups/brasil-saas-erp
Environment=RETENTION_DAYS=14
ExecStart=/usr/local/sbin/brasil-saas-db-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
