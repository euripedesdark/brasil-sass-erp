#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

BACKUP_DIR="${BACKUP_DIR:-/var/backups/brasil-saas-erp}"
RETENTION_DAYS="${RETENTION_DAYS:-14}"
: "${SPRING_DATASOURCE_URL:?SPRING_DATASOURCE_URL não definido em /etc/brasil-saas/erp.env}"
: "${SPRING_DATASOURCE_USERNAME:?SPRING_DATASOURCE_USERNAME não definido em /etc/brasil-saas/erp.env}"
: "${SPRING_DATASOURCE_PASSWORD:?SPRING_DATASOURCE_PASSWORD não definido em /etc/brasil-saas/erp.env}"

command -v pg_dump >/dev/null || { echo "pg_dump não está instalado" >&2; exit 1; }
command -v pg_restore >/dev/null || { echo "pg_restore não está instalado" >&2; exit 1; }

# Converte a URL JDBC do Spring para parâmetros libpq sem expor senha na linha de comando.
mapfile -t DB_INFO < <(python3 - "$SPRING_DATASOURCE_URL" <<'PY'
import sys
from urllib.parse import urlparse, parse_qs, unquote
raw = sys.argv[1]
if not raw.startswith("jdbc:postgresql://"):
    raise SystemExit("SPRING_DATASOURCE_URL não é uma URL PostgreSQL JDBC")
u = urlparse(raw[5:])
if not u.path or u.path == "/":
    raise SystemExit("A URL JDBC não contém o nome do banco")
q = parse_qs(u.query)
print(u.hostname or "127.0.0.1")
print(u.port or 5432)
print(unquote(u.path.lstrip("/")))
print(q.get("sslmode", [""])[0])
PY
)
if [ "${#DB_INFO[@]}" -lt 4 ]; then
  echo "Não foi possível interpretar SPRING_DATASOURCE_URL" >&2
  exit 1
fi
DB_HOST="${DB_INFO[0]}"
DB_PORT="${DB_INFO[1]}"
DB_NAME="${DB_INFO[2]}"
DB_SSLMODE="${DB_INFO[3]}"

export PGPASSWORD="$SPRING_DATASOURCE_PASSWORD"
if [ -n "$DB_SSLMODE" ]; then export PGSSLMODE="$DB_SSLMODE"; fi

install -d -o root -g root -m 0700 "$BACKUP_DIR"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
FINAL="$BACKUP_DIR/postgresql-${DB_NAME}-${STAMP}.dump"
TEMP="$BACKUP_DIR/.$(basename "$FINAL").partial"
trap 'rm -f "$TEMP"' EXIT

echo "Iniciando backup PostgreSQL: database=$DB_NAME host=$DB_HOST port=$DB_PORT"
pg_dump --host="$DB_HOST" --port="$DB_PORT" --username="$SPRING_DATASOURCE_USERNAME" \
  --dbname="$DB_NAME" --format=custom --compress=6 --no-owner --no-acl --file="$TEMP"
test -s "$TEMP"
pg_restore --list "$TEMP" >/dev/null
chmod 0600 "$TEMP"
mv -- "$TEMP" "$FINAL"
trap - EXIT

# Retém 14 dias por padrão; arquivos mais recentes nunca são removidos.
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'postgresql-*.dump' -mtime +"$RETENTION_DAYS" -delete
echo "Backup concluído e validado: $FINAL"
