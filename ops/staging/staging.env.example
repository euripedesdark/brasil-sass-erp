# Modelo para /etc/brasil-saas/staging.env no mesmo servidor da produção.
# Reutiliza as mesmas credenciais de banco, MongoDB, Redis, RabbitMQ e MinIO da produção.
# Preencha com os MESMOS valores do arquivo de ambiente de produção; não commitar segredos.
DB_URL=jdbc:postgresql://127.0.0.1:5432/brasil-saas
DB_USER=sa
DB_PASSWORD=SUBSTITUIR_PELA_CREDENCIAL_REAL
MONGODB_URI=SUBSTITUIR_PELA_URI_REAL_DO_MONGODB_DE_PRODUCAO
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=SUBSTITUIR_PELA_CREDENCIAL_REAL
RABBIT_PASSWORD=SUBSTITUIR_PELA_CREDENCIAL_REAL
RABBIT_VHOST=/
MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=SUBSTITUIR_PELA_CREDENCIAL_REAL
MINIO_SECRET_KEY=SUBSTITUIR_PELA_CREDENCIAL_REAL
JWT_SECRET=SUBSTITUIR_PELA_MESMA_CHAVE_JWT_DA_PRODUCAO
SERVER_PORT=8081
DB_POOL_MAX=3
DB_POOL_MIN=1
BRASIL_SAAS_AUTH_SERVICE_ENABLED=true
BRASIL_SAAS_AUTH_SERVICE_URL=http://127.0.0.1:8181
BRASIL_SAAS_AD_ENABLED=false

# Não definir URL pública até você informar qual hostname/IP deve abrir o staging.
# Se for testar Stripe, use URLs compatíveis com o endereço real do staging.
STRIPE_SUCCESS_URL=http://localhost:8081/financeiro/stripe/sucesso?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:8081/financeiro/stripe/cancelado
