# Exemplo de /etc/brasil-saas/staging.env — preencher com credenciais de STAGING.
# Não copiar os valores de produção. Arquivo deve pertencer a root e ter modo 0600.
STAGING_DB_URL=jdbc:postgresql://127.0.0.1:5432/brasil-saas-staging?currentSchema=brasil_saas&sslmode=verify-ca&sslrootcert=/etc/brasil-saas/pki/ca.crt&sslcert=/etc/brasil-saas/pki/issued/sa.crt&sslkey=/etc/brasil-saas/pki/private/sa.pk8
STAGING_DB_USER=sa
STAGING_DB_PASSWORD=CHANGE_ME
STAGING_MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/brasil-saas-staging?authSource=admin
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=staging
RABBIT_PASSWORD=CHANGE_ME
RABBIT_VHOST=/staging
STAGING_MINIO_URL=http://127.0.0.1:9000
STAGING_MINIO_ACCESS_KEY=CHANGE_ME
STAGING_MINIO_SECRET_KEY=CHANGE_ME
STAGING_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
SERVER_PORT=8081
DB_POOL_MAX=5
DB_POOL_MIN=1

# Sem dominio publico configurado: callbacks locais, isolados da producao.
STAGING_STRIPE_SUCCESS_URL=http://localhost:8081/financeiro/stripe/sucesso?session_id={CHECKOUT_SESSION_ID}
STAGING_STRIPE_CANCEL_URL=http://localhost:8081/financeiro/stripe/cancelado
